// Lint and format settings for the edge functions.
{
  "lint": {
    "include": ["supabase/functions"],
    "rules": {
      "tags": ["recommended"],
      // Supabase deploys each function on its own, so inline jsr: imports are the documented pattern.
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "include": ["supabase/functions"],
    // Saved OpenDota matches, kept byte for byte as downloaded (minus player names).
    "exclude": ["supabase/functions/_shared/report/fixtures"],
    "lineWidth": 120
  }
}
