// Lint and format settings for the edge functions.
{
  "lint": {
    "include": ["supabase/functions"],
    "rules": {
      "tags": ["recommended"],
      // Supabase deploys each function on its own, so inline jsr: imports are the documented pattern.
      "exclude": ["no-import-prefix"]
    }
  },
  "fmt": {
    "include": ["supabase/functions"],
    // Saved OpenDota and STRATZ answers, kept as downloaded (minus player names), one player per line.
    "exclude": [
      "supabase/functions/_shared/report/fixtures",
      "supabase/functions/_shared/similar/fixtures/stratz-matches.json"
    ],
    "lineWidth": 120
  }
}
